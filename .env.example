# ── Android app secrets ───────────────────────────────────────────
# This file is read by the Secrets Gradle Plugin and exposed as BuildConfig
# fields. Keep it free of real secrets in git; put real values in .env.

# Optional: Sentry DSN for free crash/error reporting.
# Create a free project at https://sentry.io (Developer plan) and paste the DSN.
# Leave blank to disable crash reporting entirely.
SENTRY_DSN=

# Gemini (optional, only if you later re-enable AI Studio / Google AI calls).
# GEMINI_API_KEY=
